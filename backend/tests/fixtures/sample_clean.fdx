<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="1">
<TitlePage>
<Content>
<Paragraph Type="Title">
<Text>THE LAST BUS HOME</Text>
</Paragraph>
</Content>
</TitlePage>
<Content>
<Paragraph Type="Scene Heading">
<Text>INT. PLANT NURSERY - DAY</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>RUKHMIKA waters a row of potted plants. VASANTH's motorbike rolls up outside the gate.</Text>
</Paragraph>
<Paragraph Type="Character">
<Text>VASANTH</Text>
</Paragraph>
<Paragraph Type="Parenthetical">
<Text>(calling out)</Text>
</Paragraph>
<Paragraph Type="Dialogue">
<Text>Hey! You're late again.</Text>
</Paragraph>
<Paragraph Type="Character">
<Text>RUKHMIKA</Text>
</Paragraph>
<Paragraph Type="Parenthetical">
<Text>(not looking up)</Text>
</Paragraph>
<Paragraph Type="Dialogue">
<Text>The plants don't water themselves, Vasanth.</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>He parks the bike and walks toward her, brushing dust off his jacket.</Text>
</Paragraph>
<Paragraph Type="Scene Heading">
<Text>INT. VASANTH ROOM - EVENING</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>VASANTH sits on his bed, phone in hand. He dials a number.</Text>
</Paragraph>
<Paragraph Type="Character">
<Text>VASANTH</Text>
</Paragraph>
<Paragraph Type="Parenthetical">
<Text>(into phone)</Text>
</Paragraph>
<Paragraph Type="Dialogue">
<Text>Hello... Rukhmika?</Text>
</Paragraph>
<Paragraph Type="Character">
<Text>RUKHMIKA (O.S.)</Text>
</Paragraph>
<Paragraph Type="Parenthetical">
<Text>(muffled, distant)</Text>
</Paragraph>
<Paragraph Type="Dialogue">
<Text>Who is this?</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>He laughs nervously and sits up straighter.</Text>
</Paragraph>
<Paragraph Type="Scene Heading">
<Text>EXT. BUS STOP - EARLY MORNING</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>VASANTH waits at an empty bus stop, checking his watch every few seconds.</Text>
</Paragraph>
<Paragraph Type="Character">
<Text>VASANTH</Text>
</Paragraph>
<Paragraph Type="Parenthetical">
<Text>(to himself)</Text>
</Paragraph>
<Paragraph Type="Dialogue">
<Text>Two hours. Two hours already.</Text>
</Paragraph>
<Paragraph Type="Action">
<Text>A bus finally pulls up, brakes hissing.</Text>
</Paragraph>
<Paragraph Type="Transition">
<Text>FADE OUT.</Text>
</Paragraph>
</Content>
</FinalDraft>
